# doc/../doc/examples/example09.xml:44-49
gap> LoadPackage("gbnp", false);
true
gap> SetInfoLevel(InfoGBNP,2);
gap> SetInfoLevel(InfoGBNPTime,0);

# doc/../doc/examples/example09.xml:53-55
gap> GBNP.ConfigPrint("x","y");

# doc/../doc/examples/example09.xml:60-64
gap> xyx := [[[1,2,1],[2]],[1,-1]];;
gap> yxy := [[[2,1,2],[2]],[1,-1]];;
