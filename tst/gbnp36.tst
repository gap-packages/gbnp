# doc/../doc/examples/example12.xml:154-164
gap> r := [[[2,2,2,2,1,1,1,1]],[1]];;
gap> s := StrongNormalFormTraceDiff(r, GB);;

gap> PrintNP(s.pol);
 f^4e^4
gap> PrintTracePol(s);
