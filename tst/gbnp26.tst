gap> START_TEST("gbnp26.tst");

# doc/../doc/examples/example15.xml:45-50
gap> LoadPackage("gbnp", false);
true
gap> SetInfoLevel(InfoGBNP,2);
gap> SetInfoLevel(InfoGBNPTime,0);

# doc/../doc/examples/example15.xml:54-56
gap> GBNP.ConfigPrint("x","y");

# doc/../doc/examples/example15.xml:62-69
gap> k1 := [[[2,2,2,2],[2,2]],[1,-1]];;
gap> k2 := [[[1,1,2],[1,2]],[1,-1]];;
gap> KI := [k1,k2];;
gap> PrintNPList(KI);
 y^4 - y^2
 x^2y - xy

# doc/../doc/examples/example15.xml:74-87
gap> GB := SGrobner(KI);;
#I  number of entered polynomials is 2
#I  number of polynomials after reduction is 2
#I  End of phase I
#I  End of phase II
#I  List of todo lengths is [ 0 ]
#I  End of phase III
#I  G: Cleaning finished, 0 polynomials reduced
#I  End of phase IV
gap> PrintNPList(GB);
 x^2y - xy
 y^4 - y^2

# doc/../doc/examples/example15.xml:100-107
gap> L:=LMonsNP(GB);
[ [ 1, 1, 2 ], [ 2, 2, 2, 2 ] ]
gap> fd:=FinCheckQA(L,2);
false
gap> fd:=DetermineGrowthQA(L,2,false);
"exponential growth"

# doc/../doc/examples/example15.xml:114-131
gap> w := [[[1],[2]],[1,1]];;
gap> hlp := [[[]],[1]];;
gap> for i in [3..5] do
>   hlp := MulQA(hlp, w, GB);
>   Print("\n (x+y)^",i," = \n");
>   PrintNP(hlp);
> od;

 (x+y)^3 =
 y + x

 (x+y)^4 =
 y^2 + yx + xy + x^2

 (x+y)^5 =
 y^3 + y^2x + yxy + yx^2 + xy^2 + xyx + x^3 + xy

#
gap> STOP_TEST("gbnp26.tst", 1);
