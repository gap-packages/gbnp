# doc/../doc/examples/example11.xml:54-56
gap> GBNP.ConfigPrint("x","y");

# doc/../doc/examples/example11.xml:60-62
gap> n := 16;;

# doc/../doc/examples/example11.xml:67-72
gap> s1 :=[[[1,1,1,2,2],[1,1,1,1,1,1],[2,2,2,2]],[1,-1,1]];;
gap> s2 :=[[[2,2,1,1,1],[1,2,1,2,1],[1,1,2,1,2]],[1,1,1]];;
gap> K := [s1,s2];;
gap> weights:=[2,3];;

# doc/../doc/examples/example11.xml:76-80
gap> PrintNPList(K);
 x^3y^2 - x^6 + y^4
 y^2x^3 + xyxyx + x^2yxy

# doc/../doc/examples/example11.xml:86-90
gap> CheckHomogeneousNPs(K,weights);
#I  Input is homogeneous
[ 12, 12 ]

