gap> START_TEST("gbnp22.tst");

# doc/../doc/examples/example10.xml:41-46
gap> LoadPackage("gbnp", false);
true
gap> SetInfoLevel(InfoGBNP,1);
gap> SetInfoLevel(InfoGBNPTime,0);

# doc/../doc/examples/example10.xml:51-73
gap> F:=GF(7);; ef:=One(F);;
gap> A:=FreeAssociativeAlgebraWithOne(F, "a", "b", "c", "d", "e", "f", "g");
<algebra-with-one over GF(7), with 7 generators>
gap> gens:=GeneratorsOfAlgebra(A);
[ (Z(7)^0)*<identity ...>, (Z(7)^0)*a, (Z(7)^0)*b, (Z(7)^0)*c, (Z(7)^0)*d,
  (Z(7)^0)*e, (Z(7)^0)*f, (Z(7)^0)*g ]
gap> a:=gens[2];; b:=gens[3];; c:=gens[4];; d:=gens[5];; e:=gens[6];; f:=gens[7];;
gap> g:=gens[8];; ea:=gens[1];;

gap> rels := [ a^3 + f*a,
>         a^9 + c*a^3 + g*a,
>         a^81 + c*a^9 + d*a^3,
>         c*a^81 + d*a^9 + e*a^3,
>         a^27 + d*a^81 + e*a^9 + f*a^3,
>         b + c*a^27 + e*a^81 + f*a^9 + g*a^3,
>         c*b + d*a^27 + f*a^81 + g*a^9,
>         a + d*b + e*a^27 + g*a^81,
>         c*a + e*b + f*a^27,
>         d*a + f*b + g*a^27,
>         e*a + g*b,
>         b^3 - b ];;

# doc/../doc/examples/example10.xml:77-83
gap> for i in [1..6] do
>     for j in [i+1..7] do
>         Add(rels,gens[i+1]*gens[j+1]-gens[j+1]*gens[i+1]);
>     od;
> od;

# doc/../doc/examples/example10.xml:88-90
gap> KI:=GP2NPList(rels);;

# doc/../doc/examples/example10.xml:95-116
gap> GB := SGrobner(KI);;
#I  number of entered polynomials is 33
#I  number of polynomials after reduction is 33
#I  End of phase I
#I  End of phase II
#I  End of phase III
#I  End of phase IV
gap> PrintNPList(GB);
 a
 b
 dc + Z(7)^3cd
 ec + Z(7)^3ce
 ed + Z(7)^3de
 fc + Z(7)^3cf
 fd + Z(7)^3df
 fe + Z(7)^3ef
 gc + Z(7)^3cg
 gd + Z(7)^3dg
 ge + Z(7)^3eg
 gf + Z(7)^3fg

# doc/../doc/examples/example10.xml:125-129
gap> F := LMonsNP(GB);;
gap> FinCheckQA(F,7);
false

# doc/../doc/examples/example10.xml:140-143
gap> DetermineGrowthQA(F,7,false);
5

# doc/../doc/examples/example10.xml:147-150
gap> DetermineGrowthQA(F,7,true);
5

#
gap> STOP_TEST("gbnp22.tst", 1);
