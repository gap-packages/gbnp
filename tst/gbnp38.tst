gap> START_TEST("gbnp38.tst");

# doc/../doc/examples/example25.xml:27-32
gap> LoadPackage("gbnp", false);
true
gap> SetInfoLevel(InfoGBNP,0);
gap> SetInfoLevel(InfoGBNPTime,0);

# doc/../doc/examples/example25.xml:41-68
gap> KI := [ [[[2,2]],[1]],
>         [[[1,1]],[1]],
>         [[[3,3]],[1]],
>         [[[1,2,1],[1]],[1,-1]],
>         [[[2,1,2],[2]],[1,-1]],
>         [[[3,2,3],[3]],[1,-1]],
>         [[[2,3,2],[2]],[1,-1]],
>         [[[1,3,1],[1]],[1,-1]],
>         [[[3,1,3],[3]],[1,-1]],
>         [[[1,2,3,1,2,3,1],[1,3,2,1,3,2,1],[1]],[1,1,-1]],
>         [[[3,1,2,3,1,2,3],[3,2,1,3,2,1,3],[3]],[1,1,-1]],
>         [[[2,3,1,2,3,1,2],[2,1,3,2,1,3,2],[2]],[1,1,-1]],
>       ];;
gap> PrintNPList(KI);
 b^2
 a^2
 c^2
 aba - a
 bab - b
 cbc - c
 bcb - b
 aca - a
 cac - c
 abcabca + acbacba - a
 cabcabc + cbacbac - c
 bcabcab + bacbacb - b

# doc/../doc/examples/example25.xml:74-77
gap> GBT := SGrobnerTrace(KI);;
gap> GB := List([1..Length(GBT)], i -> GBT[i].pol);;

# doc/../doc/examples/example25.xml:81-84
gap> DimQA(GB,3);
37

# doc/../doc/examples/example25.xml:88-91
gap> PrintNP(GB[Length(GB)]);
 cabcabca + cbacba - ca

# doc/../doc/examples/example25.xml:94-97
gap> PrintTracePol(GBT[Length(GBT)]);
- G(9)bacba + cG(10)

# doc/../doc/examples/example25.xml:104-111
gap> B := BaseQA(GB,3,0);;
gap> M := MatricesQA(3,B,GB);;
gap> f := MinimalPolynomial(Rationals,M[1]+M[2]+M[3]);
x_1^7-6*x_1^5+9*x_1^3-3*x_1
gap> Factors(f);
[ x_1, x_1^6-6*x_1^4+9*x_1^2-3 ]

#
gap> STOP_TEST("gbnp38.tst", 1);
