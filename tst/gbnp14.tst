gap> START_TEST("gbnp14.tst");

# doc/../doc/examples/example01.xml:45-50
gap> LoadPackage("gbnp", false);
true
gap> SetInfoLevel(InfoGBNP,2);
gap> SetInfoLevel(InfoGBNPTime,0);

# doc/../doc/examples/example01.xml:55-64
gap> Lnp := [ [[[1,2],[2,1]],[1,-1]]   ];
[ [ [ [ 1, 2 ], [ 2, 1 ] ], [ 1, -1 ] ] ]
gap> x2y := [[[1,1,2],[]],[1,-1]];
[ [ [ 1, 1, 2 ], [  ] ], [ 1, -1 ] ]
gap>     AddSet(Lnp,x2y);
gap> xy2 := [[[1,2,2],[]],[1,-1]];
[ [ [ 1, 2, 2 ], [  ] ], [ 1, -1 ] ]
gap>     AddSet(Lnp,xy2);

# doc/../doc/examples/example01.xml:68-73
gap> PrintNPList(Lnp);
 a^2b - 1
 ab - ba
 ab^2 - 1

# doc/../doc/examples/example01.xml:77-79
gap> GBNP.ConfigPrint("x","y");

# doc/../doc/examples/example01.xml:87-102
gap> GB := SGrobner(Lnp);
#I  number of entered polynomials is 3
#I  number of polynomials after reduction is 3
#I  End of phase I
#I  End of phase II
#I  length of G =1
#I  length of todo is 1
#I  length of G =2
#I  length of todo is 0
#I  List of todo lengths is [ 1, 1, 0 ]
#I  End of phase III
#I  G: Cleaning finished, 0 polynomials reduced
#I  End of phase IV
[ [ [ [ 2 ], [ 1 ] ], [ 1, -1 ] ], [ [ [ 1, 1, 1 ], [  ] ], [ 1, -1 ] ] ]

# doc/../doc/examples/example01.xml:106-110
gap> PrintNPList(GB);
 y - x
 x^3 - 1

# doc/../doc/examples/example01.xml:116-119
gap> DimQA(GB,2);
3

# doc/../doc/examples/example01.xml:127-133
gap> B:=BaseQA(GB,2,0);;
gap> PrintNPList(B);
 1
 x
 x^2

# doc/../doc/examples/example01.xml:139-146
gap> f:=[[[1,2,1,2,1,2,1]],[1]];;
gap> PrintNP(f);
 xyxyxyx
gap> p:=StrongNormalFormNP(f,GB);;
gap> PrintNP(p);
 x

