gap> START_TEST("gbnp30.tst");

# doc/../doc/examples/example19.xml:41-46
gap> LoadPackage("gbnp", false);
true
gap> SetInfoLevel(InfoGBNP,0);
gap> SetInfoLevel(InfoGBNPTime,0);

# doc/../doc/examples/example19.xml:59-64
gap> A:=FreeAssociativeAlgebraWithOne(Rationals, "a", "b");
<algebra-with-one over Rationals, with 2 generators>
gap> g:=GeneratorsOfAlgebra(A);;
gap> a:=g[2];;b:=g[3];;e:=g[1];;

# doc/../doc/examples/example19.xml:68-71
gap> twosidrels:=[a^4-e,b^2-e,(a*b)^2-e];;
gap> prefrels:=[ b-e, e + a * (e + a + b) ];;

# doc/../doc/examples/example19.xml:77-79
gap> GBR:=SGrobnerModule(GP2NPList(prefrels),GP2NPList(twosidrels));;

# doc/../doc/examples/example19.xml:85-98
gap> PrintNPList(GBR.ts);
 b^2 - 1
 aba - b
 ba^2 - a^2b
 bab - a^3
 a^4 - 1
 a^3b - ba
gap> PrintNPList(GBR.p);
[ b - 1 ]
[ ab + a^2 + a + 1 ]
[ a^3 + a^2 + a + 1 ]
[ a^2b - a^2 ]

# doc/../doc/examples/example19.xml:107-113
gap> B:=BaseQM(GBR,2,1,0);;
gap> PrintNPList(B);
[ 1 ]
[ a ]
[ a^2 ]

#
gap> STOP_TEST("gbnp30.tst", 1);
